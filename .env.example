# =============================================================================
# Cartoony Environment Configuration (.env.example)
# Copy this file to `.env.local` and fill in your values. Never commit secrets.
# =============================================================================

# 1. Manual Admin Authentication (Phase 6 & 7A)
# Generate a password hash via Node:
#   node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex');console.log('scrypt:'+s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" "YOUR_PASSWORD"
# Generate a 32-byte session secret via Node:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=admin@cartoony.local
ADMIN_PASSWORD_HASH=scrypt:<16-byte-salt-hex>:<64-byte-scrypt-derived-key-hex>
ADMIN_SESSION_SECRET=<32-byte-random-hex-secret>

# 2. Supabase PostgreSQL Connection (Phase 8)
# Public URL and anon key (enforces Row Level Security: published rows only)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Server-only privileged key (NEVER expose to client or prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=<YOUR_SUPABASE_SECRET_KEY>
