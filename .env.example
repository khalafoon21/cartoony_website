# Local: copy to .env.local (ignored by Git). Vercel: add these in Project
# Settings > Environment Variables for Production; use separate Preview values.
# Placeholders only. Never commit credentials or print them in build logs.

# Public project identity; public reads remain subject to Supabase RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_key>

# Server-only. Never prefix privileged/admin variables with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=<sb_secret_key>
ADMIN_EMAIL=<admin-email>
# scrypt: 32 hexadecimal salt characters, then 128 hexadecimal derived-key characters.
ADMIN_PASSWORD_HASH=scrypt:<salt-hex>:<derived-key-hex>
# Independent cryptographically random secret, at least 32 characters (64 hex recommended).
# Identical across instances of one environment; also signs session-bound upload tickets.
ADMIN_SESSION_SECRET=<random-session-secret>

# Optional legacy alternatives, only when the corresponding modern key is absent:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy-anon-jwt>
# SUPABASE_SERVICE_ROLE_KEY=<legacy-service-role-jwt>

# TMDB API (Server-only). Used by admin to import movie/series metadata.
TMDB_API_KEY=<tmdb-v3-api-key>

# NODE_ENV and VERCEL_ENV are managed by Vercel; do not override them.
# Canonical site: https://cartoony.site (src/lib/site.ts).
